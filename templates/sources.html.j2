<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sources</title><link rel="icon" href="{{ asset_urls.icon }}" type="image/svg+xml"><link rel="stylesheet" href="{{ asset_urls.css }}" integrity="sha256-{{ asset_integrities.css }}"></head><body class="detail"><header><span>configured sources</span><a href="/">digest</a></header><main><ul class="source-list">{% for source in sources %}<li><a href="{{ source.feed_url }}" rel="noopener noreferrer" target="_blank">{{ source.name }} ↗</a><p>{{ source.description }}</p></li>{% endfor %}</ul></main></body></html>
