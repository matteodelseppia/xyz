<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Run trace · {{ publication.publication_date }}</title><link rel="icon" href="{{ asset_urls.icon }}" type="image/svg+xml"><link rel="stylesheet" href="{{ asset_urls.css }}" integrity="sha256-{{ asset_integrities.css }}"><script src="{{ asset_urls.script }}" integrity="sha256-{{ asset_integrities.script }}" defer></script></head><body class="detail"><header><span>run trace · {{ publication.publication_date }}</span><a href="/days/{{ publication.publication_date }}/">digest</a></header><main class="trace-main"><div class="trace-actions"><p class="note">A redacted, inspectable record of Pi prompts, outputs, and tool calls. Fetched source bodies are never included.</p><button type="button" data-copy-prompt>copy raw trace</button></div><div class="trace-controls"><label>search trace <input type="search" data-trace-search placeholder="task, role, tool…" autocomplete="off"></label><div class="trace-filters" aria-label="Filter trace events"><button type="button" data-trace-filter="all" aria-pressed="true">all</button><button type="button" data-trace-filter="system" aria-pressed="false">prompts</button><button type="button" data-trace-filter="input" aria-pressed="false">inputs</button><button type="button" data-trace-filter="output" aria-pressed="false">outputs</button><button type="button" data-trace-filter="tool" aria-pressed="false">tools</button></div></div><p class="trace-summary" data-trace-summary>Loading redacted trace…</p><section class="trace-events" data-trace-events aria-label="Trace events"></section><details class="raw-trace"><summary>raw redacted trace</summary><pre data-prompt-transcript>{{ transcript_json }}</pre></details></main></body></html>